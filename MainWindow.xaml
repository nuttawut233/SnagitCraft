<Window x:Class="SnagitAnything.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnagitCraft" Width="980" Height="680" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBg}"
        FontFamily="Segoe UI" UseLayoutRounding="True">
    <DockPanel Margin="20,16,20,12">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="14,10" Margin="8,0,0,0" Click="Settings_Click" ToolTip="ปุ่มลัด และหน้าต่างจับภาพลอย">
                <TextBlock Text="⚙ ตั้งค่า" FontSize="14" />
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Padding="22,10" FontSize="15" Click="Capture_Click">
                <TextBlock><Run Text="● จับภาพ" FontWeight="SemiBold" /><Run Text="   Print Screen" Foreground="#CCFFFFFF" FontSize="12" /></TextBlock>
            </Button>
            <Image DockPanel.Dock="Left" Source="{StaticResource AppLogo}" Width="48" Height="48" Margin="0,0,12,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="SnagitCraft" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" />
                <TextBlock x:Name="HotkeyStatus" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Capture modes -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Style="{StaticResource ModeCard}" Click="Capture_Click" Width="220">
                <StackPanel>
                    <TextBlock Text="⬚  พื้นที่ / หน้าต่าง" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="ลากเพื่อเลือก หรือคลิกหน้าต่าง" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" />
                    <TextBlock Text="Print Screen" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,6,0,0" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ModeCard}" Click="CaptureMonitor_Click" Width="220">
                <StackPanel>
                    <TextBlock Text="▭  จอที่เมาส์อยู่" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="ทั้งจอที่ตัวชี้เมาส์อยู่ตอนนี้" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" />
                    <TextBlock Text="Shift + Print Screen" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,6,0,0" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ModeCard}" Click="CaptureFull_Click" Width="220">
                <StackPanel>
                    <TextBlock Text="▣  เต็มจอทุกจอ" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="ทุกจอรวมกันเป็นภาพเดียว" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" />
                    <TextBlock Text="Ctrl + Print Screen" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,6,0,0" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Options -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Divider}" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="หน่วงเวลา" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="DelayBox" Width="80" SelectionChanged="Option_Changed" Margin="0,0,18,0">
                        <ComboBoxItem Content="ไม่มี" Tag="0" />
                        <ComboBoxItem Content="3 วินาที" Tag="3" />
                        <ComboBoxItem Content="5 วินาที" Tag="5" />
                        <ComboBoxItem Content="10 วินาที" Tag="10" />
                    </ComboBox>
                    <CheckBox x:Name="OpenEditorBox" Content="เปิดหน้าแก้ไขหลังจับภาพ" VerticalAlignment="Center" Margin="0,0,18,0" Click="Option_Changed" />
                    <CheckBox x:Name="ClipboardBox" Content="คัดลอกไปคลิปบอร์ด" VerticalAlignment="Center" Margin="0,0,18,0" Click="Option_Changed" />
                    <CheckBox x:Name="AutoSaveBox" Content="บันทึกอัตโนมัติ" VerticalAlignment="Center" Margin="0,0,6,0" Click="Option_Changed" />
                    <ComboBox x:Name="FormatBox" Width="70" SelectionChanged="Option_Changed">
                        <ComboBoxItem Content="PNG" Tag="png" />
                        <ComboBoxItem Content="JPG" Tag="jpg" />
                        <ComboBoxItem Content="BMP" Tag="bmp" />
                    </ComboBox>
                </WrapPanel>
                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="เปิดโฟลเดอร์" Click="OpenFolder_Click" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="เปลี่ยน…" Click="ChangeFolder_Click" />
                    <TextBlock Text="เก็บภาพที่" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock x:Name="FolderText" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Recent captures -->
        <DockPanel DockPanel.Dock="Top" Margin="2,0,0,6">
            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="⟳ รีเฟรช" Click="Refresh_Click" />
            <TextBlock x:Name="RecentTitle" Text="ภาพล่าสุด" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Divider}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <ListBox x:Name="RecentList" BorderThickness="0" Background="Transparent" Margin="6"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Recent_DoubleClick"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="เปิดในหน้าแก้ไข" Click="RecentOpen_Click" />
                            <MenuItem Header="คัดลอกภาพ" Click="RecentCopy_Click" />
                            <MenuItem Header="แสดงในโฟลเดอร์" Click="RecentReveal_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="170" Margin="4" ToolTip="{Binding Path}">
                                <Border Height="110" Background="#FFF0F1F3" CornerRadius="4">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4" />
                                </Border>
                                <TextBlock Text="{Binding Caption}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="2,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Text="ยังไม่มีภาพ — กด Print Screen เพื่อเริ่มจับภาพ" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMuted}" Visibility="Collapsed" />
            </Grid>
        </Border>
    </DockPanel>
</Window>
