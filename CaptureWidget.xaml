<Window x:Class="SnagitAnything.CaptureWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnagitCraft Capture" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False" SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual" FontFamily="Segoe UI" FontSize="13" Foreground="#FFE6E6E6" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="RoundIcon" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#FFE6E6E6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bg" Fill="#FF3A3A3C" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="#FF4E4E52" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProfileItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="8,4" CornerRadius="3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3A3A3C" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1E5E99" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The window hugs one screen edge. Its content slides toward that edge to auto-hide; the parts that
         leave the window are transparent there, so clicks go through to whatever is underneath. -->
    <Border x:Name="Root" Background="#F22B2B2D" BorderBrush="#FF4A4A4A" BorderThickness="1" CornerRadius="8"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.5" />
        </Border.Effect>
        <!-- Rows / columns and the order of the three parts are set in code for the docked edge. -->
        <Grid x:Name="Layout">
            <!-- Profiles (collapsible) -->
            <DockPanel x:Name="ProfilesPanel" Width="236" Margin="10,8,10,8" Visibility="Collapsed">
                <TextBlock DockPanel.Dock="Top" Text="โปรไฟล์การจับภาพ" HorizontalAlignment="Center" Foreground="#FFCFCFCF" Margin="0,0,0,6" />
                <Rectangle DockPanel.Dock="Top" Height="1" Fill="#FF4A4A4A" Margin="0,0,0,6" />
                <Button DockPanel.Dock="Bottom" Content="ตั้งค่าโปรไฟล์และปุ่มลัด…" Click="Settings_Click" Cursor="Hand" Margin="0,8,0,0" Padding="6,4"
                        Foreground="#FFE6E6E6" Background="#FF3A3A3C" BorderBrush="#FF555555" />
                <Rectangle DockPanel.Dock="Bottom" Height="1" Fill="#FF4A4A4A" Margin="0,6,0,0" />
                <ListBox x:Name="Profiles" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ProfileItem}"
                         SelectionChanged="Profiles_SelectionChanged" MouseDoubleClick="Profiles_DoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel ToolTip="{Binding Description}">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Width="22" Foreground="#FFB8B8B8" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Hotkey}" Foreground="#FF8FB8E8" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding Name}" Foreground="#FFE6E6E6" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Blue strip: toggles the profile list; it is also the tab that stays visible when tucked away -->
            <Border x:Name="Strip" Background="#FF1E6FB5" Cursor="Hand"
                    ToolTip="แสดง / ซ่อนโปรไฟล์การจับภาพ  •  ลากเพื่อย้ายไปขอบจออื่น">
                <TextBlock x:Name="StripIcon" Text="☰" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Buttons -->
            <StackPanel x:Name="Buttons" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="EditorButton" Style="{StaticResource RoundIcon}" Click="Editor_Click" ToolTip="เปิดหน้าแก้ไข">
                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                </Button>
                <Button x:Name="CaptureButton" Width="62" Height="62" Cursor="Hand" Click="Capture_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse Fill="White" />
                                <Ellipse x:Name="Dot" Fill="#FFE53935" Margin="4" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Dot" Property="Fill" Value="#FFF25450" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Dot" Property="Fill" Value="#FFC62828" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="GearButton" Style="{StaticResource RoundIcon}" Click="Settings_Click" ToolTip="ตั้งค่า">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
