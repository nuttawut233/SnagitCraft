<Window x:Class="SnagitAnything.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnagitCraft Editor" Width="1400" Height="860" MinWidth="820" MinHeight="520"
        WindowStartupLocation="Manual" Background="#FF1E1E1E" FontFamily="Segoe UI" FontSize="12"
        Foreground="#FFE6E6E6" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="DkTitle" Color="#FF1F1F1F" />
        <SolidColorBrush x:Key="DkRibbon" Color="#FF2D2D2D" />
        <SolidColorBrush x:Key="DkLine" Color="#FF434343" />
        <SolidColorBrush x:Key="DkText" Color="#FFE6E6E6" />
        <SolidColorBrush x:Key="DkMuted" Color="#FF9A9A9A" />
        <SolidColorBrush x:Key="DkHover" Color="#FF3E3E40" />
        <SolidColorBrush x:Key="DkPressed" Color="#FF505052" />
        <SolidColorBrush x:Key="DkChecked" Color="#FF4A4A4C" />
        <SolidColorBrush x:Key="DkAccent" Color="#FF1E73BE" />
        <SolidColorBrush x:Key="DkCanvas" Color="#FF252526" />
        <SolidColorBrush x:Key="DkTray" Color="#FF1A1A1A" />

        <!-- Icon strokes follow the button's Foreground. -->
        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="SnapsToDevicePixels" Value="False" />
        </Style>

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource DkText}" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DkHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFC42B1C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QatButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
        </Style>

        <!-- Ribbon tab header -->
        <Style x:Key="TabHeader" TargetType="RadioButton">
            <Setter Property="GroupName" Value="ribbonTabs" />
            <Setter Property="Foreground" Value="{StaticResource DkText}" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DkHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DkRibbon}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DkAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small square tool button (Drawing Tools grid) -->
        <Style x:Key="ToolButton" TargetType="RadioButton">
            <Setter Property="GroupName" Value="tools" />
            <Setter Property="Foreground" Value="{StaticResource DkText}" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DkHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DkChecked}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF6AA0D8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Big ribbon button: icon over label -->
        <Style x:Key="BigButton" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="{StaticResource DkText}" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="5,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Top" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DkHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small ribbon button: icon + label in a row (Outline / Fill / Effects) -->
        <Style x:Key="SmallButton" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="{StaticResource DkText}" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DkHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DkMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="GroupDivider" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Fill" Value="{StaticResource DkLine}" />
            <Setter Property="Margin" Value="6,4" />
        </Style>
        <Style x:Key="BigLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="LineHeight" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="70" />
        </Style>

        <!-- Quick Styles gallery item -->
        <Style x:Key="GalleryItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="#FF3A3A3C" BorderThickness="2" BorderBrush="Transparent" CornerRadius="3" Padding="2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF7A7A7C" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF6AA0D8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrayItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="4,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="#FF2A2A2A" BorderThickness="2" BorderBrush="Transparent" Padding="2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF6A6A6A" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF3D8EE0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#FF2D2D30" />
            <Setter Property="Foreground" Value="{StaticResource DkText}" />
            <Setter Property="BorderBrush" Value="{StaticResource DkLine}" />
        </Style>

        <Style x:Key="DkCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="#FF3A3A3A" BorderThickness="1">
        <DockPanel>
            <!-- ================= Title bar with Quick Access Toolbar ================= -->
            <Grid DockPanel.Dock="Top" Height="32" Background="{StaticResource DkTitle}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Image Source="{StaticResource AppLogo}" Width="20" Height="20" Margin="2,0,8,0" />
                    <Button Style="{StaticResource QatButton}" ToolTip="บันทึก (Ctrl+S)" Click="Save_Click">
                        <Path Style="{StaticResource Icon}" Data="M4,3 H14 L17,6 V17 H4 Z M7,3 V8 H13 V3 M7,17 V12 H14 V17" />
                    </Button>
                    <Button x:Name="QatUndo" Style="{StaticResource QatButton}" ToolTip="เลิกทำ (Ctrl+Z)" Click="Undo_Click">
                        <Path Style="{StaticResource Icon}" Data="M7,5 L3,9 L7,13 M3,9 H12 A5,5 0 0 1 12,19 H8" />
                    </Button>
                    <Button x:Name="QatRedo" Style="{StaticResource QatButton}" ToolTip="ทำซ้ำ (Ctrl+Y)" Click="Redo_Click">
                        <Path Style="{StaticResource Icon}" Data="M13,5 L17,9 L13,13 M17,9 H8 A5,5 0 0 0 8,19 H12" />
                    </Button>
                    <Button Style="{StaticResource QatButton}" ToolTip="คัดลอกทั้งหมด (Ctrl+C)" Click="CopyAll_Click">
                        <Path Style="{StaticResource Icon}" Data="M7,7 H16 V17 H7 Z M4,13 V3 H13" />
                    </Button>
                </StackPanel>
                <TextBlock x:Name="TitleText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource DkMuted}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ChromeButton}" Click="Minimize_Click" ToolTip="ย่อ">
                        <Path Style="{StaticResource Icon}" StrokeThickness="1" Data="M5,10.5 H15" />
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" Click="Maximize_Click" ToolTip="ขยาย">
                        <Path x:Name="MaxIcon" Style="{StaticResource Icon}" StrokeThickness="1" Data="M5.5,5.5 H14.5 V14.5 H5.5 Z" />
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="Close_Click" ToolTip="ปิด">
                        <Path Style="{StaticResource Icon}" StrokeThickness="1" Data="M5.5,5.5 L14.5,14.5 M14.5,5.5 L5.5,14.5" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= Ribbon tabs ================= -->
            <Grid DockPanel.Dock="Top" Background="{StaticResource DkTitle}">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="FileButton" Click="File_Click" Cursor="Hand" Padding="18,5" Foreground="White">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{StaticResource DkAccent}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#FF2B86D6" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="ไฟล์" />
                        <Button.ContextMenu>
                            <ContextMenu x:Name="FileMenu">
                                <MenuItem Header="ใหม่จากคลิปบอร์ด" InputGestureText="Ctrl+N" Click="NewFromClipboard_Click" />
                                <MenuItem Header="เปิด…" InputGestureText="Ctrl+O" Click="Open_Click" />
                                <Separator />
                                <MenuItem Header="บันทึก" InputGestureText="Ctrl+S" Click="Save_Click" />
                                <MenuItem Header="บันทึกเป็น…" InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click" />
                                <MenuItem Header="คัดลอกทั้งหมด" InputGestureText="Ctrl+C" Click="CopyAll_Click" />
                                <MenuItem Header="พิมพ์…" InputGestureText="Ctrl+P" Click="Print_Click" />
                                <Separator />
                                <MenuItem Header="แสดงในโฟลเดอร์" Click="Reveal_Click" />
                                <MenuItem Header="ปิด" Click="Close_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <RadioButton x:Name="TabTools" Style="{StaticResource TabHeader}" Content="เครื่องมือ" IsChecked="True" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabImage" Style="{StaticResource TabHeader}" Content="รูปภาพ" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabShare" Style="{StaticResource TabHeader}" Content="แชร์" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabLibrary" Style="{StaticResource TabHeader}" Content="คลังภาพ" Checked="Tab_Checked" />
                </StackPanel>
            </Grid>

            <!-- ================= Ribbon panels ================= -->
            <Border DockPanel.Dock="Top" Background="{StaticResource DkRibbon}" BorderBrush="{StaticResource DkLine}" BorderThickness="0,0,0,1" Height="96" Padding="6,4,6,2">
                <Grid>
                    <!-- ===== Tools ===== -->
                    <StackPanel x:Name="PanelTools" Orientation="Horizontal">
                        <!-- Drawing Tools -->
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="เครื่องมือวาด" Style="{StaticResource GroupLabel}" />
                            <UniformGrid x:Name="ToolGrid" Rows="2" Columns="6" VerticalAlignment="Center">
                                <RadioButton Style="{StaticResource ToolButton}" Tag="Select" ToolTip="เลือก / ย้าย / ปรับขนาด (V)" IsChecked="True">
                                    <Path Style="{StaticResource Icon}" StrokeThickness="1.3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Data="M5,2.5 L5,16 L8.5,12.5 L11,18 L13,17 L10.5,11.5 L15,11.5 Z" />
                                </RadioButton>
                                <RadioButton Style="{StaticResource ToolButton}" Tag="Callout" ToolTip="Callout ข้อความในกรอบ (K)">
                                    <Path Style="{StaticResource Icon}" Data="M4,3.5 H16 A1.5,1.5 0 0 1 17.5,5 V11.5 A1.5,1.5 0 0 1 16,13 H9 L5,17 L6,13 H4 A1.5,1.5 0 0 1 2.5,11.5 V5 A1.5,1.5 0 0 1 4,3.5 Z" />
                                </RadioButton>
                                <RadioButton Style="{StaticResource ToolButton}" Tag="Arrow" ToolTip="ลูกศร (A)">
                                    <Path Style="{StaticResource Icon}" StrokeThickness="2" Data="M3.5,16.5 L15.5,4.5 M9,4.5 H15.5 V11" />
                                </RadioButton>
                                <RadioButton Style="{StaticResource ToolButton}" Tag="Pen" ToolTip="ปากกา วาดอิสระ (P)">
                                    <Path Style="{StaticResource Icon}" StrokeThickness="2" Data="M2.5,15 C5,6 8,17 11,9 S15.5,5 17.5,4" />
                                </RadioButton>
                                <RadioButton Style="{StaticResource ToolButton}" Tag="Highlight" ToolTip="ไฮไลต์ (H)">
                                    <Path Style="{StaticResource Icon}" Stroke="#FFFDD835" StrokeThickness="6" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" Data="M3,10 H17" />
                                </RadioButton>
                                <RadioButton Style="{StaticResource ToolButton}" Tag="Text" ToolTip="ข้อความ (T)">
                                    <TextBlock Text="T" FontSize="17" FontWeight="Bold" FontFamily="Georgia" />
                                </RadioButton>
                                <RadioButton Style="{StaticResource ToolButton}" Tag="Line" ToolTip="เส้นตรง (L)">
                                    <Path Style="{StaticResource Icon}" StrokeThickness="2" Data="M3.5,16.5 L16.5,3.5" />
                                </RadioButton>
                                <RadioButton Style="{StaticResource ToolButton}" Tag="Rectangle" ToolTip="สี่เหลี่ยม (R)">
                                    <Path Style="{StaticResource Icon}" Data="M3,5 H17 V15 H3 Z" />
                                </RadioButton>
                                <RadioButton Style="{StaticResource ToolButton}" Tag="Ellipse" ToolTip="วงรี (E)">
                                    <Ellipse Width="16" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" StrokeThickness="1.6" />
                                </RadioButton>
                                <RadioButton Style="{StaticResource ToolButton}" Tag="Step" ToolTip="ลำดับขั้น 1 2 3 (S)">
                                    <Grid Width="19" Height="19">
                                        <Ellipse Fill="#FFE53935" />
                                        <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </RadioButton>
                                <RadioButton Style="{StaticResource ToolButton}" Tag="Blur" ToolTip="เบลอ / ปิดข้อมูล (B)">
                                    <Grid Width="16" Height="16">
                                        <UniformGrid Rows="4" Columns="4">
                                            <Rectangle Fill="#FF8A8A8A" /><Rectangle Fill="#FF5A5A5A" /><Rectangle Fill="#FFB0B0B0" /><Rectangle Fill="#FF6E6E6E" />
                                            <Rectangle Fill="#FF5A5A5A" /><Rectangle Fill="#FFB0B0B0" /><Rectangle Fill="#FF6E6E6E" /><Rectangle Fill="#FF9A9A9A" />
                                            <Rectangle Fill="#FFB0B0B0" /><Rectangle Fill="#FF6E6E6E" /><Rectangle Fill="#FF9A9A9A" /><Rectangle Fill="#FF5A5A5A" />
                                            <Rectangle Fill="#FF6E6E6E" /><Rectangle Fill="#FF9A9A9A" /><Rectangle Fill="#FF5A5A5A" /><Rectangle Fill="#FFB0B0B0" />
                                        </UniformGrid>
                                    </Grid>
                                </RadioButton>
                                <RadioButton Style="{StaticResource ToolButton}" Tag="Crop" ToolTip="ครอบตัด (C)">
                                    <Path Style="{StaticResource Icon}" Data="M6,2.5 V14 H17.5 M2.5,6 H14 V17.5" />
                                </RadioButton>
                            </UniformGrid>
                        </DockPanel>
                        <Rectangle Style="{StaticResource GroupDivider}" />

                        <!-- Styles -->
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="สไตล์" Style="{StaticResource GroupLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="568" Height="64">
                                    <ListBox x:Name="Gallery" Background="#FF262628" BorderBrush="{StaticResource DkLine}" BorderThickness="1"
                                             ItemContainerStyle="{StaticResource GalleryItem}" SelectionChanged="Gallery_SelectionChanged"
                                             ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             PreviewMouseWheel="Gallery_MouseWheel">
                                        <ListBox.Template>
                                            <ControlTemplate TargetType="ListBox">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ScrollViewer Focusable="False" Padding="2">
                                                        <ItemsPresenter />
                                                    </ScrollViewer>
                                                </Border>
                                            </ControlTemplate>
                                        </ListBox.Template>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>
                                    <TextBlock x:Name="GalleryHint" Foreground="{StaticResource DkMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center" IsHitTestVisible="False" Text="เลือกเครื่องมือวาด หรือคลิกวัตถุบนภาพ&#x0a;เพื่อดูสไตล์ด่วน" />
                                </Grid>
                                <StackPanel Margin="6,0,0,0" Width="104" VerticalAlignment="Center">
                                    <Button x:Name="OutlineButton" Style="{StaticResource SmallButton}" Click="Outline_Click" ToolTip="สีเส้นขอบ และความหนา">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="OutlineSwatch" Width="14" Height="14" BorderBrush="#FF888888" BorderThickness="1" Margin="0,0,6,0" />
                                            <TextBlock Text="เส้นขอบ ▾" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="FillButton" Style="{StaticResource SmallButton}" Click="Fill_Click" ToolTip="สีพื้น">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="FillSwatch" Width="14" Height="14" BorderBrush="#FF888888" BorderThickness="1" Margin="0,0,6,0" />
                                            <TextBlock Text="สีพื้น ▾" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="EffectsButton" Style="{StaticResource SmallButton}" Click="Effects_Click" ToolTip="เงา">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource Icon}" Width="14" Height="14" Margin="0,0,6,0" StrokeThickness="1.3" Data="M2,2 H10 V10 H2 Z M5,12.5 H12.5 V5" />
                                            <TextBlock Text="เอฟเฟกต์ ▾" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource GroupDivider}" />

                        <!-- Text size -->
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="ตัวอักษร" Style="{StaticResource GroupLabel}" />
                            <StackPanel VerticalAlignment="Center" Width="92">
                                <Grid x:Name="FontSizeGroup" Height="26" ToolTip="ขนาดตัวอักษร (ข้อความ / Callout / ลำดับขั้น)">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource SmallButton}" HorizontalContentAlignment="Center" Content="−" Click="FontSmaller_Click" />
                                    <TextBox x:Name="FontSizeBox" Grid.Column="1" Background="#FF1E1E1E" Foreground="{StaticResource DkText}" BorderBrush="{StaticResource DkLine}"
                                             CaretBrush="White" TextAlignment="Center" VerticalContentAlignment="Center" KeyDown="FontSize_KeyDown" LostFocus="FontSize_Changed" />
                                    <Button Grid.Column="2" Style="{StaticResource SmallButton}" HorizontalContentAlignment="Center" Content="+" Click="FontBigger_Click" />
                                </Grid>
                                <TextBlock x:Name="StepInfo" Foreground="{StaticResource DkMuted}" FontSize="11" Margin="2,6,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource GroupDivider}" />

                        <Button Style="{StaticResource BigButton}" Click="RestartSequence_Click" ToolTip="เริ่มนับลำดับขั้นใหม่ที่ 1">
                            <StackPanel>
                                <Path Style="{StaticResource Icon}" Width="26" Height="26" StrokeThickness="1.8" Data="M19,7 A8,8 0 1 0 21,15 M19,2.5 V7 H14.5" />
                                <TextBlock Text="เริ่มลำดับใหม่" Style="{StaticResource BigLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BigButton}" Click="CopyAll_Click" ToolTip="คัดลอกภาพพร้อมทุกอย่างที่วาด (Ctrl+C)">
                            <StackPanel>
                                <Path Style="{StaticResource Icon}" Width="26" Height="26" Data="M8,8 H20 V22 H8 Z M4,17 V3 H15" />
                                <TextBlock Text="คัดลอกทั้งหมด" Style="{StaticResource BigLabel}" />
                            </StackPanel>
                        </Button>
                        <Rectangle Style="{StaticResource GroupDivider}" />
                        <Button Style="{StaticResource BigButton}" Click="Save_Click" ToolTip="บันทึก (Ctrl+S)">
                            <StackPanel>
                                <Path Style="{StaticResource Icon}" Width="26" Height="26" Data="M4,3 H18 L22,7 V22 H4 Z M8,3 V9 H17 V3 M8,22 V15 H18 V22" />
                                <TextBlock Text="บันทึก" Style="{StaticResource BigLabel}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- ===== Image ===== -->
                    <StackPanel x:Name="PanelImage" Orientation="Horizontal" Visibility="Collapsed">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="ขนาดภาพ" Style="{StaticResource GroupLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BigButton}" Click="CropTool_Click" ToolTip="ครอบตัด (C)">
                                    <StackPanel>
                                        <Path Style="{StaticResource Icon}" Width="26" Height="26" StrokeThickness="1.8" Data="M7,2 V19 H24 M2,7 H19 V24" />
                                        <TextBlock Text="ครอบตัด" Style="{StaticResource BigLabel}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BigButton}" Click="Trim_Click" ToolTip="ตัดขอบสีเดียวกันรอบภาพออก">
                                    <StackPanel>
                                        <Path Style="{StaticResource Icon}" Width="26" Height="26" Data="M3,3 H23 V23 H3 Z M8,8 H18 V18 H8 Z" StrokeDashArray="2 1.5" />
                                        <TextBlock Text="ตัดขอบ" Style="{StaticResource BigLabel}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BigButton}" Click="Resize_Click" ToolTip="ปรับขนาดภาพ">
                                    <StackPanel>
                                        <Path Style="{StaticResource Icon}" Width="26" Height="26" Data="M3,10 V3 H10 M3,3 L11,11 M23,16 V23 H16 M23,23 L15,15" />
                                        <TextBlock Text="ปรับขนาด" Style="{StaticResource BigLabel}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource GroupDivider}" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="หมุน" Style="{StaticResource GroupLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BigButton}" Click="RotateLeft_Click">
                                    <StackPanel>
                                        <Path Style="{StaticResource Icon}" Width="26" Height="26" StrokeThickness="1.8" Data="M6,10 A8,8 0 1 1 8,19 M6,4 V10 H12" />
                                        <TextBlock Text="หมุนซ้าย" Style="{StaticResource BigLabel}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnRotateRight" Style="{StaticResource BigButton}" Click="RotateRight_Click">
                                    <StackPanel>
                                        <Path Style="{StaticResource Icon}" Width="26" Height="26" StrokeThickness="1.8" Data="M20,10 A8,8 0 1 0 18,19 M20,4 V10 H14" />
                                        <TextBlock Text="หมุนขวา" Style="{StaticResource BigLabel}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BigButton}" Click="FlipH_Click">
                                    <StackPanel>
                                        <Path Style="{StaticResource Icon}" Width="26" Height="26" Data="M13,2 V24 M10,6 L3,19 H10 Z M16,6 L23,19 H16 Z" />
                                        <TextBlock Text="กลับซ้าย-ขวา" Style="{StaticResource BigLabel}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BigButton}" Click="FlipV_Click">
                                    <StackPanel>
                                        <Path Style="{StaticResource Icon}" Width="26" Height="26" Data="M2,13 H24 M6,10 L19,3 V10 Z M6,16 L19,23 V16 Z" />
                                        <TextBlock Text="กลับบน-ล่าง" Style="{StaticResource BigLabel}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource GroupDivider}" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="เอฟเฟกต์ภาพ" Style="{StaticResource GroupLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BigButton}" Click="Border_Click" ToolTip="ใส่กรอบภาพด้วยสี/ความหนาของ 'เส้นขอบ'">
                                    <StackPanel>
                                        <Path Style="{StaticResource Icon}" Width="26" Height="26" StrokeThickness="3" Data="M4,4 H22 V22 H4 Z" />
                                        <TextBlock Text="กรอบภาพ" Style="{StaticResource BigLabel}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BigButton}" Click="ImageShadow_Click">
                                    <StackPanel>
                                        <Path Style="{StaticResource Icon}" Width="26" Height="26" Data="M3,3 H18 V18 H3 Z M7,21.5 H21.5 V7" StrokeThickness="2" />
                                        <TextBlock Text="เงาภาพ" Style="{StaticResource BigLabel}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnGrayscale" Style="{StaticResource BigButton}" Click="Grayscale_Click">
                                    <StackPanel>
                                        <Grid Width="26" Height="26">
                                            <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Margin="3" />
                                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M13,3 A10,10 0 0 1 13,23 Z" />
                                        </Grid>
                                        <TextBlock Text="ขาวดำ" Style="{StaticResource BigLabel}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>

                    <!-- ===== Share ===== -->
                    <StackPanel x:Name="PanelShare" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Style="{StaticResource BigButton}" Click="CopyAll_Click">
                            <StackPanel>
                                <Path Style="{StaticResource Icon}" Width="26" Height="26" Data="M8,8 H20 V22 H8 Z M4,17 V3 H15" />
                                <TextBlock Text="คลิปบอร์ด" Style="{StaticResource BigLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BigButton}" Click="SaveAs_Click">
                            <StackPanel>
                                <Path Style="{StaticResource Icon}" Width="26" Height="26" Data="M3,6 H10 L12,8 H23 V21 H3 Z" />
                                <TextBlock Text="ไฟล์…" Style="{StaticResource BigLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BigButton}" Click="Print_Click">
                            <StackPanel>
                                <Path Style="{StaticResource Icon}" Width="26" Height="26" Data="M7,10 V3 H19 V10 M4,10 H22 V18 H4 Z M7,15 H19 V23 H7 Z" />
                                <TextBlock Text="พิมพ์" Style="{StaticResource BigLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BigButton}" Click="Reveal_Click">
                            <StackPanel>
                                <Path Style="{StaticResource Icon}" Width="26" Height="26" Data="M3,6 H10 L12,8 H23 V21 H3 Z M10,15 H17 M14,12 L17,15 L14,18" />
                                <TextBlock Text="แสดงในโฟลเดอร์" Style="{StaticResource BigLabel}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- ===== Library ===== -->
                    <StackPanel x:Name="PanelLibrary" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Style="{StaticResource BigButton}" Click="OpenLibrary_Click">
                            <StackPanel>
                                <Path Style="{StaticResource Icon}" Width="26" Height="26" Data="M3,4 H10 V11 H3 Z M14,4 H21 V11 H14 Z M3,14 H10 V21 H3 Z M14,14 H21 V21 H14 Z" />
                                <TextBlock Text="เปิดคลังภาพ" Style="{StaticResource BigLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BigButton}" Click="Open_Click">
                            <StackPanel>
                                <Path Style="{StaticResource Icon}" Width="26" Height="26" Data="M3,6 H10 L12,8 H20 V11 M3,21 V6 M3,21 L7,11 H24 L20,21 Z" />
                                <TextBlock Text="เปิดไฟล์…" Style="{StaticResource BigLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BigButton}" Click="NewFromClipboard_Click">
                            <StackPanel>
                                <Path Style="{StaticResource Icon}" Width="26" Height="26" Data="M9,4 H6 V23 H20 V4 H17 M9,2 H17 V6 H9 Z M13,10 V18 M9,14 H17" />
                                <TextBlock Text="จากคลิปบอร์ด" Style="{StaticResource BigLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BigButton}" Click="RefreshTray_Click">
                            <StackPanel>
                                <Path Style="{StaticResource Icon}" Width="26" Height="26" StrokeThickness="1.8" Data="M20,8 A8,8 0 1 0 21,15 M20,3 V8 H15" />
                                <TextBlock Text="รีเฟรช" Style="{StaticResource BigLabel}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= Status bar ================= -->
            <Border DockPanel.Dock="Bottom" Background="#FF1E6FB5" Height="26" Padding="8,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ZoomText" Foreground="White" Width="46" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Button Style="{StaticResource SmallButton}" Foreground="White" Content="−" Width="20" HorizontalContentAlignment="Center" Click="ZoomOut_Click" />
                        <Slider x:Name="ZoomSlider" Width="120" Minimum="5" Maximum="400" VerticalAlignment="Center" ValueChanged="ZoomSlider_Changed" />
                        <Button Style="{StaticResource SmallButton}" Foreground="White" Content="+" Width="20" HorizontalContentAlignment="Center" Click="ZoomIn_Click" />
                        <Button Style="{StaticResource SmallButton}" Foreground="White" Content="พอดีจอ" Click="ZoomFit_Click" Margin="6,0,0,0" />
                        <Button Style="{StaticResource SmallButton}" Foreground="White" Content="100%" Click="ZoomActual_Click" />
                        <ToggleButton x:Name="TrayToggle" Style="{StaticResource SmallButton}" Foreground="White" IsChecked="True" Checked="TrayToggle_Changed" Unchecked="TrayToggle_Changed" Margin="8,0,0,0" ToolTip="แสดง/ซ่อนถาดภาพ">
                            <TextBlock Text="▦ ถาดภาพ" />
                        </ToggleButton>
                    </StackPanel>
                    <TextBlock x:Name="SizeText" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock x:Name="StatusText" Foreground="#FFDCE9F7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!-- ================= Captures tray ================= -->
            <Border x:Name="TrayPanel" DockPanel.Dock="Bottom" Background="{StaticResource DkTray}" BorderBrush="{StaticResource DkLine}" BorderThickness="0,1,0,0" Height="96">
                <ListBox x:Name="Tray" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource TrayItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         SelectionChanged="Tray_SelectionChanged" VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="110" Height="70" ToolTip="{Binding Caption}">
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- ================= Canvas ================= -->
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="{StaticResource DkCanvas}" Focusable="False">
                <Grid x:Name="ZoomHost" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
                    </Grid.LayoutTransform>
                    <Border x:Name="ImageBackdrop" Background="White" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.6" />
                        </Border.Effect>
                    </Border>
                    <!-- Everything inside ImageHost is in image pixels and is what gets saved. -->
                    <Grid x:Name="ImageHost">
                        <Image x:Name="BaseImage" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Canvas x:Name="AnnotationLayer" />
                    </Grid>
                    <!-- Interaction layer: selection, handles, crop preview, mouse input. Not saved. -->
                    <Canvas x:Name="InputLayer" Background="Transparent"
                            MouseLeftButtonDown="Input_MouseDown" MouseMove="Input_MouseMove" MouseLeftButtonUp="Input_MouseUp"
                            MouseRightButtonUp="Input_RightClick">
                        <Rectangle x:Name="SelectionOutline" Stroke="#FF3D8EE0" StrokeThickness="1.5" StrokeDashArray="4 3" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Rectangle x:Name="HandleA" Width="10" Height="10" Fill="White" Stroke="#FF1E73BE" StrokeThickness="1.5" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Rectangle x:Name="HandleB" Width="10" Height="10" Fill="White" Stroke="#FF1E73BE" StrokeThickness="1.5" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Rectangle x:Name="CropPreview" Stroke="White" StrokeThickness="1.5" StrokeDashArray="5 3" Fill="#22FFFFFF" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Canvas.ContextMenu>
                            <ContextMenu x:Name="ObjectMenu">
                                <MenuItem Header="แก้ไขข้อความ" Click="EditText_Click" x:Name="MenuEditText" />
                                <MenuItem Header="ทำสำเนา" InputGestureText="Ctrl+D" Click="Duplicate_Click" />
                                <MenuItem Header="นำมาไว้หน้าสุด" Click="BringToFront_Click" />
                                <MenuItem Header="ส่งไปหลังสุด" Click="SendToBack_Click" />
                                <Separator />
                                <MenuItem Header="ลบ" InputGestureText="Delete" Click="Delete_Click" />
                            </ContextMenu>
                        </Canvas.ContextMenu>
                    </Canvas>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
