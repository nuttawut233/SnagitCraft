<?xml version="1.0" encoding="utf-8"?>
<!-- Project-local package source: the self-contained publish (installer build) downloads the .NET
     runtime packs from nuget.org. Kept here so the build works without any machine-wide NuGet setup. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
